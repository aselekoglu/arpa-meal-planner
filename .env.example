# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required when the OpenAI provider is selected.
# Keep this server-side only; never expose it through Vite/client env variables.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Optional OpenAI-compatible API base URL. Leave unset for the official API.
# OPENAI_BASE_URL="https://api.openai.com/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional default provider when requests omit provider.
# Supported: gemini | openai | ollama | mlx
AI_PROVIDER_DEFAULT="gemini"

# Optional model overrides.
AI_GEMINI_TEXT_MODEL="gemini-3-flash-preview"
AI_GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
AI_OPENAI_MODEL="gpt-5.6-luna"
# Optional separate OpenAI model for receipt/image understanding.
AI_OPENAI_VISION_MODEL="gpt-5.6-luna"
AI_OLLAMA_MODEL="llama3.1:8b"
AI_MLX_MODEL="mlx-community/Llama-3.1-8B-Instruct-4bit"

# Local provider endpoints.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
MLX_BASE_URL="http://127.0.0.1:8080/v1"
# MLX_API_KEY=""
